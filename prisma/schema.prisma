generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ORGANIZADOR
  PARTICIPANTE
  ADMIN
}

enum EventStatus {
  ATIVO
  CANCELADO
  FINALIZADO
}

enum InscricaoStatus {
  CONFIRMADO
  CANCELADO
  PRESENTE
  LISTA_ESPERA
}

model Usuario {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  telefone  String?
  papel     Role     @default(PARTICIPANTE)
  fotoUrl   String?
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  eventos   Evento[]
  inscricoes Inscricao[]
  avaliacoes Avaliacao[]
  listaEspera ListaEspera[]

  @@map("usuarios")
}

model Categoria {
  id        Int      @id @default(autoincrement())
  nome      String
  descricao String?
  cor       String   @default("#3B82F6")
  icone     String   @default("sport")
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
  eventos   Evento[]

  @@map("categorias")
}

model Local {
  id        Int      @id @default(autoincrement())
  nome      String
  endereco  String
  cidade    String
  cep       String
  capacidade Int?
  tipo      String   @default("Quadra")
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
  eventos   Evento[]

  @@map("locais")
}

model Evento {
  id              Int         @id @default(autoincrement())
  titulo          String
  descricao       String
  dataHora        DateTime
  duracaoMin      Int         @default(60)
  vagasTotal      Int
  vagasDisponiveis Int
  preco           Decimal?    @default(0)
  categoriaId     Int
  localId         Int
  organizadorId   Int
  status          EventStatus @default(ATIVO)
  imagemUrl       String?
  criadoEm        DateTime   @default(now())
  atualizadoEm    DateTime   @updatedAt
  categoria       Categoria   @relation(fields: [categoriaId], references: [id])
  local           Local       @relation(fields: [localId], references: [id])
  organizador     Usuario     @relation(fields: [organizadorId], references: [id])
  inscricoes      Inscricao[]
  avaliacoes      Avaliacao[]
  listaEspera     ListaEspera[]

  @@map("eventos")
}

model Inscricao {
  id             Int             @id @default(autoincrement())
  eventoId       Int
  usuarioId      Int
  status         InscricaoStatus @default(CONFIRMADO)
  dataInscricao  DateTime      @default(now())
  checkinEm      DateTime?
  observacao     String?
  evento         Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario        Usuario   @relation(fields: [usuarioId], references: [id])

  @@unique([eventoId, usuarioId])
  @@map("inscricoes")
}

model Avaliacao {
  id          Int      @id @default(autoincrement())
  eventoId    Int
  usuarioId   Int
  nota        Int
  comentario  String?
  criadoEm    DateTime @default(now())
  evento      Evento   @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario     Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([eventoId, usuarioId])
  @@map("avaliacoes")
}

model ListaEspera {
  id           Int      @id @default(autoincrement())
  eventoId     Int
  usuarioId    Int
  posicao      Int
  dataEntrada  DateTime @default(now())
  notificadoEm DateTime?
  evento       Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  usuario      Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([eventoId, usuarioId])
  @@map("lista_espera")
}